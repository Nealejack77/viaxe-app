# Copy to .env.local (gitignored) to point the app at a local viaxe-os
# backend instead of production — see viaxe-os/dev-preview/server.js.
#
#   cp .env.local.example .env.local
#   (cd ../viaxe-os && node dev-preview/server.js)   # in one terminal
#   npx expo start --web                             # in another

EXPO_PUBLIC_API_BASE=http://localhost:4100/api
